# cp .env.example .env, then change the values
# The values below are fake development values: a plain copy is enough to start the stack.
# Generate a real secret:     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate a real Fernet key: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# Postgres user for the Airflow metadata database
POSTGRES_USER=airflow
# Postgres password for the Airflow metadata database
POSTGRES_PASSWORD=dev-only-postgres-password
# Postgres database name for the Airflow metadata
POSTGRES_DB=airflow

# UID that Airflow containers run as and that owns the /data layout
AIRFLOW_UID=50000
# Fernet key that encrypts Airflow connections and variables (32 bytes, urlsafe base64)
AIRFLOW_FERNET_KEY=ZGV2LW9ubHktZmVybmV0LWtleS1jaGFuZ2UtbWUtMDA=
# JWT secret shared by the API server, scheduler and dag-processor
AIRFLOW_JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
# JWT issuer shared by every Airflow component
AIRFLOW_JWT_ISSUER=diplomap
# API secret key shared by every Airflow component (sessions and log fetching)
AIRFLOW_API_SECRET_KEY=dev-only-api-secret-change-me-0123456789
# Airflow UI admin login
AIRFLOW_ADMIN_USERNAME=admin
# Airflow UI admin password
AIRFLOW_ADMIN_PASSWORD=dev-only-admin-password
# Host port of the Airflow UI and API (8080 is already used on this machine)
AIRFLOW_WEB_PORT=8081

# Password of the neo4j user (at least 8 characters)
NEO4J_PASSWORD=dev-only-neo4j-password
# Host port of the Neo4j Browser (HTTP)
NEO4J_HTTP_PORT=7474
# Host port of the Neo4j Bolt protocol
NEO4J_BOLT_PORT=7687

# Host port of the FastAPI backend
BACKEND_PORT=8000
# Host port of the frontend
FRONTEND_PORT=3000

# Token to log in to Jupyter
JUPYTER_TOKEN=dev-only-jupyter-token
# Host port of Jupyter
JUPYTER_PORT=8888
# UID Jupyter runs as, so it can save notebooks in business_questions/ (set to the output of: id -u)
JUPYTER_UID=1000
